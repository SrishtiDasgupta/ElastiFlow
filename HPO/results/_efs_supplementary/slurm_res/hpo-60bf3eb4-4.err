+ echo '[INFO] Shutting down Ray Cluster ..........'
+ srun --label bash -c 'ray stop'
+ echo '[INFO] HPO Completed!'
+ cleanup
+ echo '[INFO] Cleaning up Ray on all nodes...'
+ for node in $nodes
+ srun --overlap -N1 -n1 -w gpu-compute-st-g4dn-nodes-1 bash -c 'source ~/rayenv/bin/activate && ray stop'
+ for node in $nodes
+ srun --overlap -N1 -n1 -w gpu-compute-st-g4dn-nodes-2 bash -c 'source ~/rayenv/bin/activate && ray stop'
+ for node in $nodes
+ srun --overlap -N1 -n1 -w gpu-compute-st-g4dn-nodes-3 bash -c 'source ~/rayenv/bin/activate && ray stop'
+ for node in $nodes
+ srun --overlap -N1 -n1 -w gpu-compute-st-g4dn-nodes-4 bash -c 'source ~/rayenv/bin/activate && ray stop'
