```python
def allocateResourcesHPO(self, constraints, sim=None):
    # Priority 1: Reserved instances
    for instance in instances:
        if instance.type == 'reserved' and matches_optimal_type:
            selected.append((instance, slots))

    # Priority 2: On-demand (if budget allows)
    if trials > 0:
        for instance in instances:
            if instance.type == 'on-demand' and matches_optimal_type:
                # Check budget with cold start
                cost = estimate_with_cold_start(instance, trials, epochs)
                if cost < budget:
                    selected.append((instance, slots))

    # Allocate virtual slots
    ips, alloc = self.resource_manager.allocateResources(selected)

    # Create actual on-demand instances
    ips = self.createOnDemandWorkers(ips, sim)

    return ips, alloc

def createOnDemandWorkers(self, ips, sim):
    """Create actual on-demand worker instances"""
    for instance_type, (count, ip_list) in ips.get('on-demand', {}).items():
        if count > 0 and len(ip_list) == 0:
            worker_ips = createWorkerInstances(instance_type, count, sim)
            ips['on-demand'][instance_type] = (count, worker_ips)
    return ips
```

